{
  "crons": [
    {
      "path": "/api/scheduler",
      "schedule": "0 0 * * *"
    }
  ],
  "env": {
    "CRON_SECRET": "${CRON_SECRET}",
    "DATABASE_URL": "${DATABASE_URL}"
  },
  "buildCommand": "prisma generate && next build",
  "functions": {
    "app/api/scheduler/route.ts": {
      "memory": 512
    },
    "app/api/art-digest/route.ts": {
      "memory": 1024
    }
  }
} 