NODE_ENV=node_env_here
NEXT_PUBLIC_BASE_URL=next_public_base_url_here

# Gmail Configuration
GMAIL_USER=your.email@gmail.com # your.email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here # Get this from Google Account settings

# Google Analytics Configuration
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga_measurement_id_here # G-XXXXXXXXXX

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here # sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# News API Key
NEWS_API_KEY=your_news_api_key_here # XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# News API Base URL
NEWS_API_BASE_URL=your_news_api_base_url_here # https://newsapi.org/v2

# Auth-related environment variables
NEXTAUTH_SECRET=your_nextauth_secret_here # use-a-strong-random-string-here
NEXTAUTH_URL=your_nextauth_url_here # https://unjica.com

# Database URL
DATABASE_URL=your_database_url_here # postgresql://postgres.visavjridpgdjukdgwfl:[DATABASE_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Scheduler Security
CRON_SECRET=your_cron_secret_here # unjica-super-secret-cron-key-please-change-in-production